# =============================================================================
# HubAssist backend environment template.
#
# Copy this file to `backend/.env` and fill in real values. The shape and
# defaults documented here must stay in sync with
# `src/config/validation.schema.ts` (the runtime Joi validator) and the
# Environment Variables Reference section of the root README.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Required.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hubassist

# -----------------------------------------------------------------------------
# JWT / Auth
# -----------------------------------------------------------------------------
# Secret used to sign short-lived access tokens. Required. Use a long
# (32+ char) random string in production — rotate if compromised.
JWT_SECRET=change-me-in-production
# Access token TTL. Accepts ms-style durations (e.g. "15m", "1h", "2d").
JWT_EXPIRES_IN=1h
# Secret used to sign refresh tokens. Required. MUST differ from JWT_SECRET.
REFRESH_TOKEN_SECRET=change-me-in-production
# Refresh token TTL.
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Email (SMTP) — optional; required only if you enable email features.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@hubassist.com

# -----------------------------------------------------------------------------
# Cloudinary (file uploads) — optional; required only if uploads are enabled.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Stellar / Contracts
# -----------------------------------------------------------------------------
# Network the backend should interact with. One of: testnet | mainnet.
STELLAR_NETWORK=testnet
# Soroban RPC endpoint to use. Optional — defaults to the public testnet/
# mainnet endpoint matching STELLAR_NETWORK. Set explicitly to point at a
# private/backup RPC provider.
STELLAR_RPC_URL=
# Bounded timeout (ms) applied to every outbound Stellar RPC request.
STELLAR_RPC_TIMEOUT_MS=10000
# Max retry attempts (with exponential backoff) for a failed Stellar RPC
# call before it fails fast with a typed error.
STELLAR_RPC_MAX_RETRIES=3
# Base delay (ms) for the exponential backoff between Stellar RPC retries.
STELLAR_RPC_RETRY_BASE_DELAY_MS=200
# Deployed `workspace_booking` contract ID (starts with "C..."). Optional
# until the contract is deployed; required for booking on-chain calls.
WORKSPACE_BOOKING_CONTRACT_ID=
# Deployed `membership_token` contract ID. Optional until deployed.
MEMBERSHIP_TOKEN_CONTRACT_ID=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Runtime mode. One of: development | production | test.
NODE_ENV=development
# Log level. One of: fatal | error | warn | info | debug | trace | silent.
# Defaults to "debug" in development and "info" in production.
LOG_LEVEL=
# Allowed CORS origin (browser will be rejected if it doesn't match).
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Redis (caching & JWT blacklist) — optional; falls back to in-memory cache when not set.
# Required in production for JWT token revocation (logout, role-change, security incidents).
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Password Policy
# -----------------------------------------------------------------------------
# Set to true to enable the Have I Been Pwned (HIBP) k-anonymity breach check
# on password creation/change. Only the first 5 hex chars of the SHA-1 hash
# are sent to the HIBP API — the full password never leaves the server.
# Defaults to false (opt-in).
HIBP_CHECK_ENABLED=false
